# theme = Monokai Pro Light Sun
theme = Vague

keybind = ctrl+tab=unbind
# keybind = ctrl+tab=text:\x03cd -\x0d
keybind = ctrl+.=text:\x03cd $(git rev-parse --show-toplevel)\x0d
# keybind = ctrl+shift+tab=text:\x03kp -\x0d
keybind = alt+arrow_left=ignore
keybind = alt+arrow_right=ignore

keybind = ctrl+shift+tab=ignore
keybind = super+shift+bracket_right=ignore
keybind = super+shift+bracket_left=ignore
keybind = super+bracket_left=ignore
keybind = super+bracket_right=ignore

keybind = alt+super+h=goto_split:left
keybind = alt+super+k=goto_split:up
keybind = alt+super+j=goto_split:down
keybind = alt+super+l=goto_split:right

# keybind = alt+super+minus=resize_split:left,10
# keybind = alt+super+shift+minus=resize_split:up,10
# keybind = alt+super+shift+plus=resize_split:down,10
# keybind = alt+super+plus=resize_split:right,10

keybind = super+ctrl+f=unbind 
# i have macos native fullscreen
keybind = alt+super+shift+enter=unbind
keybind = alt+super+enter=toggle_split_zoom 
# pass through to apps like nvim
keybind = super+enter=unbind 
# i have macos native fullscreen
keybind = super+shift+enter=unbind 
# I have logic that flows beter with alt as well for spit zoom
keybind = super+shift+d=unbind 
# I have better logic for split screen with alt and hjkl
keybind = super+d=unbind 
# I have better logic for split screen with alt and hjkl
keybind = alt+super+shift+l=new_split:right
keybind = alt+super+shift+h=new_split:left
keybind = alt+super+shift+j=new_split:down
keybind = alt+super+shift+k=new_split:up
keybind = alt+super+shift+equal=equalize_splits

# to clear screen sometimes terminals have command+l dop something simillar to ctrl+l and tehn command+k do full on app layer clear screen.
# in ghostty it seems that by default they only have the command+k concept and so why not direcly map it top command+l
keybind = super+k=unbind 
keybind = super+l=clear_screen

keybind = alt+super+r=prompt_surface_title

