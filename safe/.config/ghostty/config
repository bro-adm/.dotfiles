# theme = Monokai Pro Light Sun
theme = Vague

keybind = ctrl+tab=text:\x03cd -\x0d
# keybind = ctrl+shift+tab=text:\x03kp -\x0d
keybind = alt+arrow_left=ignore
keybind = alt+arrow_right=ignore

keybind = ctrl+shift+tab=ignore
keybind = super+shift+bracket_right=ignore
keybind = super+shift+bracket_left=ignore
keybind = super+bracket_left=ignore
keybind = super+bracket_right=ignore

keybind = alt+super+bracket_left=goto_split:left
keybind = alt+super+shift+bracket_left=goto_split:up
keybind = alt+super+shift+bracket_right=goto_split:down
keybind = alt+super+bracket_right=goto_split:right

keybind = alt+super+minus=resize_split:left,10
keybind = alt+super+shift+minus=resize_split:up,10
keybind = alt+super+shift+plus=resize_split:down,10
keybind = alt+super+plus=resize_split:right,10

keybind = super+ctrl+f=ignore
keybind = super+alt+shift+enter=toggle_fullscreen
keybind = super+alt+enter=toggle_split_zoom
keybind = super+shift+d=ignore
keybind = super+d=ignore
keybind = super+alt+ctrl+bracket_right=new_split:right
keybind = super+alt+ctrl+bracket_left=new_split:left
keybind = super+alt+ctrl+shift+bracket_right=new_split:down
keybind = super+alt+ctrl+shift+bracket_left=new_split:up

keybind = super+k=ignore
keybind = super+l=clear_screen

