#!/usr/bin/env bash
# FZF-based environment variable picker

# Capture environment variables

# Launch fzf to pick one
cmd=$(history | fzf \
    --ansi --reverse \
    --tmux=75%,70% \
    --border \
    --prompt="🔎 History> " \
    --info=inline \
    --color=fg+:cyan,bg+:black,header:yellow
)

# If something is selected, show it or process it
if [[ -n "$cmd" ]]; then
    echo "cmd: $cmd"
fi
